# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Include conf.d/*

CanonicalizeHostname yes
CanonicalizeMaxDots 0

Host ssh.dev.azure.com
  User git
  PubkeyAcceptedKeyTypes +rsa-sha2-256,rsa-sha2-512
  HostKeyAlgorithms +rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-256-cert-v01@openssh.com

Host github.com
  HostName github.com
  User git

Host heonghe
  CanonicalizeHostname no
  HostName heon.ghe.com
  User heon
  IdentityFile ~/.ssh/HEON-GHE_2026-02-13.pub
  IdentitiesOnly yes

Host heongheadm
  CanonicalizeHostname no
  HostName heon.ghe.com
  User heon
  IdentityFile ~/.ssh/HEON-GHE-ADM_2026-03-04.pub
  IdentitiesOnly yes

Host *
  # https://stribika.github.io/2015/01/04/secure-secure-shell.html
  ChallengeResponseAuthentication no
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr
  ControlMaster auto
  # Use original hostname instead of canonicalized hostname to support
  # multiple connections to the same host with different keys
  ControlPath /tmp/ssh-%r@%n:%p
  ControlPersist 5m
  ForwardX11 no
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
  HashKnownHosts yes
  HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,ssh-rsa-cert-v01@openssh.com,ssh-ed25519,ssh-rsa
  KexAlgorithms curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com,hmac-sha2-512,hmac-sha2-256,umac-128@openssh.com
  SendEnv LANG
  ServerAliveCountMax 3
  ServerAliveInterval 120
  VisualHostKey yes
  VerifyHostKeyDNS ask
  # macOS specific
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  PreferredAuthentications publickey

